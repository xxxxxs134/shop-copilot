# Python AI 接入层环境变量模板
# 复制本文件为 .env 并填入真实密钥（.env 已被 gitignore）

# DeepSeek API Key（https://platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=

# 可选：DeepSeek 网关地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── RAG 知识库（都有默认值，可不配）──
# 开关：true/false（也可由请求体 rag 字段覆盖，评测脚本用）
RAG_ENABLED=true
# 嵌入提供方：local（fastembed 本地，默认）/ siliconflow（BGE-M3，需下 key）
EMBED_PROVIDER=local
# SILICONFLOW_API_KEY=

# ── 多模态：GLM-4V 图生文案（可选；未配置时 /v1/vision/caption 返回 400 中文提示）──
# VISION_API_KEY=
# VISION_MODEL=glm-4v-flash
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── 数据源 Provider（P4 插件化，都有默认值，可不配）──
# sqlite（默认）：data_query 真查 data/store.db（30 天种子数据，python -m backend.app.agent.seed_store 重建）
# mock：内置样例 dict 兜底（store.db 缺失时也自动回退 mock）
# 接入真实店铺数据：实现 backend/app/agent/data_provider.py 的 DataProvider Protocol 即可，见 README「三步接入真实数据」
DATA_PROVIDER=sqlite
